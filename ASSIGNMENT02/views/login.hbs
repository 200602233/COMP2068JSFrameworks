{{!-- Refer to week 7 of professors github --}}

<h1>
    {{#if (eq lang "es")}}
        Iniciar sesión
    {{else}}
       Login
    {{/if}}
</h1>

{{!-- error message for invalid credentiasl --}}
{{!-- may change alert colours later --}}
{{#if messages}}
    <div class="alert alert-danger">
        Invalid Credentials!!!
    </div>
{{else}}
    <div class="alert alert-info">
        Please enter your credentials.
    </div>
{{/if}}
<form method="post">
    {{!-- user --}}
    <fieldset>
        <label for="username" class="col-2">* Username: </label>
        <input name="username" id="username" required/>
    </fieldset>
    {{!-- pass --}}
    <fieldset>
        <label for="password" class="col-2">* Password: </label>
        <input name="password" id="password" required />
    </fieldset>
    {{!-- btn and if no account, direct to register --}}
    <fieldset>
        <button class="btn">Login</button>
        <hr/> Don't have an account? 
        <a href="/register" title="register">Register today!</a>
    </fieldset>
</form>