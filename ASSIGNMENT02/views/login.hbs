{{!-- Refer to week 7 of professors github --}}

<h1>
    {{#if (eq lang "es")}}
        Iniciar sesión
    {{else}}
       Login
    {{/if}}
</h1>

{{!-- error message for invalid credentiasl --}}
{{!-- may change alert colours later --}}

{{#if messages}}
    <div class="alert alert-danger">
        {{#if (eq lang "es")}}Credenciales inválidas!!
        {{else}}Invalid Credentials!!!
        {{/if}}
    </div>
{{else}}
    <div class="alert alert-info">
        {{#if (eq lang "es")}}Por favor, introduzca sus credenciales.
        {{else}}Please enter your credentials.
        {{/if}}
    </div>
{{/if}}

<form method="post">
    {{!-- user --}}
    <fieldset class="auth-form-row">
        <label for="username" class="authLabel">{{#if (eq lang "es")}}* Nombre de usuario: {{else}}* Username: {{/if}}</label>
        <input type="text" name="username" placeholder="{{#if (eq lang "es")}}usuario o correo electrónico{{else}}username or email address{{/if}}" required/>
    </fieldset>
    {{!-- pass --}}
    <fieldset class="auth-form-row">
        <label for="password" class="authLabel">{{#if (eq lang "es")}}* Contraseña: {{else}}* Password: {{/if}}</label>
        <input type="password" name="password" id="password" required />
    </fieldset>
    {{!-- btn and if no account, direct to register --}}
    <fieldset class="auth-form-row">
        <button class="btn">{{#if (eq lang "es")}}Iniciar sesión{{else}}Login{{/if}}</button>
        <a class="btn" href="/github">{{#if (eq lang "es")}}Iniciar sesión con GitHub{{else}}Login with GitHub{{/if}}</a>
        <hr/> 
        {{#if (eq lang "es")}}¿No tienes cuenta? {{else}}Don't have an account? {{/if}}<a href="/register?lang={{lang}}" title="register">{{#if (eq lang "es")}}¡Regístrate hoy!{{else}}Register today!{{/if}}</a>
    </fieldset>
</form>