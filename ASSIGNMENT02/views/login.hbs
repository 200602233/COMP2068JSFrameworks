{{!-- Refer to week 7 of professors github --}}

<h1>
    {{#if (eq lang "es")}}
        Iniciar sesión
    {{else}}
       Login
    {{/if}}
</h1>

<form method="post">
    {{!-- user --}}
    <fieldset class="auth-form-row">
        <label for="username" class="authLabel">{{#if (eq lang "es")}}* Nombre de usuario: {{else}}* Username: {{/if}}</label>
        <input type="text" name="username" placeholder="ex. Rosita" 
        {{!-- code to allow me to adjust language of message prompt that pops up --}}
        {{!-- https://www.w3schools.com/Jsref/event_oninvalid.asp --}}
        oninvalid="alert(
            {{#if (eq lang "es")}}Por favor, introduzca una dirección de correo electrónico válida.
            {{else}}Please enter valid email address.
            {{/if}})"
        oninput="this.setCustomValidity('')" 
        required/>
    </fieldset>
    {{!-- pass --}}
    <fieldset class="auth-form-row">
        <label for="password" class="authLabel">{{#if (eq lang "es")}}* Contraseña: {{else}}* Password: {{/if}}</label>
        <input type="password" name="password" id="password" required />
    </fieldset>
    {{!-- btn and if no account, direct to register --}}
    <fieldset class="auth-form-row">
        <button class="btn">{{#if (eq lang "es")}}Iniciar sesión{{else}}Login{{/if}}</button>
        <a class="btn" href="/github">{{#if (eq lang "es")}}Iniciar sesión con GitHub{{else}}Login with GitHub{{/if}}</a>
        <hr/> 
        {{#if (eq lang "es")}}¿No tienes cuenta? {{else}}Don't have an account? {{/if}}<a href="/register?lang={{lang}}" title="register" class="auth-nav-link">{{#if (eq lang "es")}}¡Regístrate hoy!{{else}}Register today!{{/if}}</a>
    </fieldset>
</form>