{{!-- Refer to week 7 of professors github --}}

<h1>
    {{#if (eq lang "es")}}
        Iniciar sesión
    {{else}}
       Login
    {{/if}}
</h1>

{{!-- error message for invalid credentiasl --}}
{{!-- may change alert colours later --}}
{{#if (eq lang "es")}}
    {{#if messages}}
        <div class="alert alert-danger">
            Invalid Credentials!!!
        </div>
    {{else}}
        <div class="alert alert-info">
            Please enter your credentials.
        </div>
    {{/if}}
{{else}}
    {{#if messages}}
        <div class="alert alert-danger">
            Invalid Credentials!!!
        </div>
    {{else}}
        <div class="alert alert-info">
            Please enter your credentials.
        </div>
    {{/if}}
{{/if}}
<form method="post">
    {{!-- user --}}
    <fieldset class="auth-form-row">
        <label for="username" class="authLabel">* Username: </label>
        <input name="username" id="username" required/>
    </fieldset>
    {{!-- pass --}}
    <fieldset class="auth-form-row">
        <label for="password" class="authLabel">* Password: </label>
        <input type="password" name="password" id="password" required />
    </fieldset>
    {{!-- btn and if no account, direct to register --}}
    <fieldset class="auth-form-row">
        <button class="btn">Login</button>
        <hr/> 
        Don't have an account? <a href="/register" title="register">Register today!</a>
    </fieldset>
</form>