
<h1>
    {{#if (eq lang "es")}}
        Todas las palabras y frases:
    {{else}}
        All Words and Phrases:
    {{/if}}
</h1>

{{!-- div for search and add new button --}}
<div>
    <div>
        <label>
            {{#if (eq lang "es")}}
                Buscar:
            {{else}}
                Search:
            {{/if}}
        </label>
        <input
        type="text"
        id="searchBar"
        placeholder="{{#if (eq lang "es")}}Busca algo aquí...{{else}}Search something here...{{/if}}">
    </div>
    <a href="/add?lang={{lang}}" class="addBtn">
        {{#if (eq lang "es")}}
            + Agregar
        {{else}}
            + Add
        {{/if}}
    </a>
</div>

{{!-- Table for the list --}}
<table>
    <thead>
        <tr>
            <th></th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td></td>
        </tr>
    </tbody>
</table>