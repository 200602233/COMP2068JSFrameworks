<!DOCTYPE html>
<html>
  <head>
    <title>{{title}}</title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
    {{!-- Add bootstrap CSS reference here --}}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  </head>

  <body>
      {{!-- Navigation(s) that will stay on EVERY page --}}
      {{!-- top nav --}}
      <nav class="top_nav navbar navbar-expand-md fixed-top">
        <div><a href="/?lang={{lang}}"><img src="/images/logo.png" class="nav-logo-top-nav" alt="logo" /></a></div>
        <div class="container-fluid">
          <!-- hamburger menu for if user makes screen smaller -->
          <button class="navbar-toggler" type="button"
                  data-bs-toggle="collapse"
                  data-bs-target="#mainNavbar"
                  aria-controls="mainNavbar"
                  aria-expanded="false"
                  aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="mainNavbar">
            <ul class="navbar-nav me-auto">
              {{#if (eq lang "es")}}
                <li>
                  <a class="nav-link" href="/?lang={{lang}}">Inicio</a>
                </li>
                <li>
                  <a class="nav-link" href="/categories?lang={{lang}}">Categorías</a>
                </li>
                {{#if user}}
                  <li>
                    <a class="nav-link" href="/logout?lang={{lang}}">Cerrar sesión</a>
                  </li>
                {{else}}
                  <li>
                    <a class="nav-link" href="/login?lang={{lang}}">Iniciar sesión</a>
                  </li>
                  <li>
                    <a class="nav-link" href="/register?lang={{lang}}">Registrarse</a>
                  </li>
                {{/if}}
              {{else}}
                <li class="nav-item">
                  <a class="nav-link" href="/?lang={{lang}}">Home</a>
                </li>
                <li class="nav-item">
                  <a class="nav-link" href="/categories?lang={{lang}}">Categories</a>
                </li>
                {{#if user}}
                  <li>
                    <a class="nav-link" href="/logout?lang={{lang}}">Log out</a>
                  </li>
                {{else}}
                  <li>
                    <a class="nav-link" href="/login?lang={{lang}}">Login</a>
                  </li>
                  <li>
                    <a class="nav-link" href="/register?lang={{lang}}">Register</a>
                  </li>
                {{/if}}
              {{/if}}
            </ul>
            <!--english or spanish-->
            <ul class="navbar-nav ms-auto d-flex flex-row gap-2">
              {{#if user}}
                {{#if (eq lang "es")}}
                  Bienvenido, {{user.username}}!
                {{else}}
                  Welcome, {{user.username}}!
                {{/if}}
              {{else}}
              {{/if}}
              {{#if (eq lang "es")}}
                <a href="{{currentUrl}}?lang=en"><img src="/images/english-flag.png" class="lang-flag" alt="english flag"/> Inglés</a>
                <a href="{{currentUrl}}?lang=es"><img src="/images/mexico_flag.png" class="lang-flag" alt="mexico flag"/> Español</a>
              {{else}}
                <a href="{{currentUrl}}?lang=en"><img src="/images/english-flag.png" class="lang-flag" alt="english flag"/> English</a>
                <a href="{{currentUrl}}?lang=es"><img src="/images/mexico_flag.png" class="lang-flag" alt="mexico flag"/> Spanish</a>
              {{/if}} 
            </ul>
          </div>
        </div>
    </nav>
    {{{body}}}
    {{!-- Bottom Nav --}}
    <nav class="bottom-nav navbar-expand">
      <div><a href="/?lang={{lang}}"><img src="/images/logo.png" class="nav-logo-bottom-nav" alt="logo" /></a></div>
      <div class="main-nav">
        <h6>{{#if (eq lang "es")}}Páginas Principales{{else}}Main Pages{{/if}}</h6>
        <ul>
          {{#if (eq lang "es")}}
            <li>
              <a class="nav-link" href="/?lang={{lang}}">Inicio</a>
            </li>
            <li>
              <a class="nav-link" href="/categories?lang={{lang}}">Categorías</a>
            </li>
            <li>
              <a class="nav-link" href="/login?lang={{lang}}">Iniciar sesión</a>
            </li>
            <li>
              <a class="nav-link" href="/register?lang={{lang}}">Registrarse</a>
            </li>
          {{else}}
            <li class="nav-item">
              <a class="nav-link" href="/?lang={{lang}}">Home</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/categories?lang={{lang}}">Categories</a>
            </li>
            <li>
              <a class="nav-link" href="/login?lang={{lang}}">Login</a>
            </li>
            <li>
              <a class="nav-link" href="/register?lang={{lang}}">Register</a>
            </li>
          {{/if}}
        </ul>
      </div>
      <div class="info-nav">
        <h6>{{#if (eq lang "es")}}Información{{else}}Information{{/if}}</h6>
        <ul>
          {{#if (eq lang "es")}}
            <li>
              <a class="nav-link" href="./about?lang={{lang}}">Acerca de</a>
            </li>
            <li>
              <a class="nav-link" href="./referrals?lang={{lang}}">Recomendaciones Sugeridas</a>
            </li>
          {{else}}
            <li>
              <a class="nav-link" href="./about?lang={{lang}}">About</a>
            </li>
            <li>
              <a class="nav-link" href="./referrals?lang={{lang}}">Suggested Referrals</a>
            </li>
          {{/if}}
        </ul>
      </div>
      <div class="lang-nav">
        <h6>{{#if (eq lang "es")}}Idioma{{else}}Language{{/if}}</h6>
        <ul>
          {{#if (eq lang "es")}}
            <a href="{{currentUrl}}?lang=en"><img src="/images/english-flag.png" class="lang-flag" alt="english flag"/> Inglés</a>
            <a href="{{currentUrl}}?lang=es"><img src="/images/mexico_flag.png" class="lang-flag" alt="mexico flag"/> Español</a>
          {{else}}
            <a href="{{currentUrl}}?lang=en"><img src="/images/english-flag.png" class="lang-flag" alt="english flag"/> English</a>
            <a href="{{currentUrl}}?lang=es"><img src="/images/mexico_flag.png" class="lang-flag" alt="mexico flag"/> Spanish</a>
          {{/if}} 
        </ul>
      </div>
    </nav>


    {{!-- Add Bootstrap --}}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js" integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy" crossorigin="anonymous"></script>
  </body>
    
</html>
