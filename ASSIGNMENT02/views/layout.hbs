<!DOCTYPE html>
<html>
  <head>
    <title>{{title}}</title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
    {{!-- Add bootstrap CSS reference here --}}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  </head>

  {{!-- Navigation(s) that will stay on EVERY page --}}
  <nav class="top_nav navbar navbar-expand-md fixed-top">
    <div class="nav-logo"></div>
    <div class="container-fluid">
      <!-- hamburger menu for if user makes screen smaller -->
      <button class="navbar-toggler" type="button"
              data-bs-toggle="collapse"
              data-bs-target="#mainNavbar"
              aria-controls="mainNavbar"
              aria-expanded="false"
              aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="mainNavbar">
        <ul class="navbar-nav me-auto">
          {{#if (eq lang "es")}}
            <li>
              <a class="nav-link" href="/?lang={{lang}}">Inicio</a>
            </li>
            <li>
              <a class="nav-link" href="/categories?lang={{lang}}">Categorías</a>
            </li>
            <li>
              <a class="nav-link" href="/login?lang={{lang}}">Iniciar sesión</a>
            </li>
            <li>
              <a class="nav-link" href="/register?lang={{lang}}">Registrarse</a>
            </li>
          {{else}}
            <li class="nav-item">
              <a class="nav-link" href="/?lang={{lang}}">Home</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/categories?lang={{lang}}">Categories</a>
            </li>
            <li>
              <a class="nav-link" href="/login?lang={{lang}}">Login</a>
            </li>
            <li>
              <a class="nav-link" href="/register?lang={{lang}}">Register</a>
            </li>
          {{/if}}
        </ul>
        <!--english or spanish-->
        <ul class="navbar-nav ms-auto d-flex flex-row gap-2">
          {{#if (eq lang "es")}}
            <a href="{{currentUrl}}?lang=en">Inglés</a>
            <a href="{{currentUrl}}?lang=es">Español (Mexicano)</a>
          {{else}}
            <a href="{{currentUrl}}?lang=en">English</a>
            <a href="{{currentUrl}}?lang=es">Spanish (Mexican)</a>
          {{/if}}
        </ul>
      </div>
    </div>
</nav>

  <body>
    {{{body}}}
    {{!-- Add Bootstrap --}}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js" integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy" crossorigin="anonymous"></script>
  </body>
</html>
