{{!-- Refer to week 7 of professors github --}}

<h1>
    {{#if (eq lang "es")}}
        Registrarse
    {{else}}
       Register
    {{/if}}
</h1>

{{!-- register form --}}
<form method="post">
    {{!-- user --}}
    <fieldset class="auth-form-row">
        <label for="username" class="authLabel">{{#if (eq lang "es")}}* Nombre de usuario: {{else}}* Username: {{/if}}</label>
        <input type="email" id="username" placeholder="ex. hola@gmail.com" required/>
    </fieldset class="auth-form-row">
    {{!-- pass --}}
    <p class="auth-p">{{#if (eq lang "es")}}La contraseña debe incluir{{else}}Password must include{{/if}}</p>
    <fieldset class="auth-form-row">
        <label for="password" class="authLabel">{{#if (eq lang "es")}}* Contraseña: {{else}}* Password: {{/if}}</label>
        <input type="password" name="password" id="password" required />
    </fieldset>
    {{!-- re-enter pass --}}
    <fieldset class="auth-form-row">
        <label for="password" class="authLabel">{{#if (eq lang "es")}}* Confirmar: {{else}}* Confirm: {{/if}} </label>
        <input type="password" name="confirm" id="confirm" required />
    </fieldset>
    {{!-- if jave account, direct to login --}}
    <fieldset class="auth-form-row">
        <button class="btn">{{#if (eq lang "es")}}Registro{{else}}Register{{/if}}</button>
        <hr/> 
        {{#if (eq lang "es")}}¿Ya tienes una cuenta?{{else}}Already have an account?{{/if}}<a href="/login" title="login">{{#if (eq lang "es")}}¡Inicia sesión ahora!{{else}}Login now!{{/if}}</a>
    </fieldset>
</form>