
<h1>{{#if (eq lang "es")}}
            Contáctenos
        {{else}}
            Contact Us
        {{/if}}</h1>

<form method="post" class="contactForm">

    <label>
        {{#if (eq lang "es")}}
            * Nombre de pila
        {{else}}
            * First Name
        {{/if}}
    </label>
    <label>
        {{#if (eq lang "es")}}
            Apellido
        {{else}}
            Last Name
        {{/if}}
    </label>
    <input
    type="text"
    name="firstName"
    id="firstName"
    placeholder="ex. John"
    required>
    <input
    type="text"
    name="lastName"
    id="lastName"
    placeholder="ex. Doe">
    <label>
        {{#if (eq lang "es")}}
            * Correo electrónico
        {{else}}
            * Email
        {{/if}}
    </label>
    <label>
        {{#if (eq lang "es")}}
            Número de teléfono
        {{else}}
            Phone Number
        {{/if}}
    </label>
    <input
    type="text"
    name="email"
    id="email"
    placeholder="ex. john.doe@gmail.com"
    required>
    <input
    type="text"
    name="phoneNum"
    id="phoneNum"
    placeholder="ex. 012-345-6789">
   <br class="dblColumnSpaced">
   <label class="dblColumnSpaced">
        {{#if (eq lang "es")}}
            * Sujeto:
        {{else}}
            * Subject:
        {{/if}}
    </label>
    <input 
    class="dblColumnSpaced"
    type="subject"
    name="subject"
    id="subject"
    required>
    <br class="dblColumnSpaced">

    <textarea 
    class="dblColumnSpaced" 
    placeholder="{{#if (eq lang "es")}}* El mensaje comienza aquí...{{else}}* Message starts here...{{/if}}"
    required></textarea>

    <br class="dblColumnSpaced"><br class="dblColumnSpaced">
    <button type="submit" class="dblColumnSpaced">{{#if (eq lang "es")}}Enviar{{else}}Send{{/if}}</button>
    <br class="dblColumnSpaced">

</form>