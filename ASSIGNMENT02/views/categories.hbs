
{{#if user}}
    <h1 class="category-h1">
        {{#if (eq lang "es")}}
            Elige tu categoría:
        {{else}}
            Choose your category:
        {{/if}}
    </h1>

    <nav class="nav-cat">
        {{#if (eq lang "es")}}
            <a href="/all?lang={{lang}}">TODO</a>
            <a href="/words?lang={{lang}}">PALABRAS</a>
            <a href="/phrases?lang={{lang}}">FRASES</a>
        {{else}}
            <a href="/all?lang={{lang}}">ALL</a>
            <a href="/words?lang={{lang}}">WORDS</a>
            <a href="/phrases?lang={{lang}}">PHRASES</a>
        {{/if}}
    </nav>
    <br>
    <h2 class="h2-cat">
        {{#if (eq lang "es")}}
            O añadir una nueva entrada:
        {{else}}
            Or add a new entry:
        {{/if}}
    </h2>

    <nav class="nav-cat" id="add-btn-cat">
        <a href="/add?lang={{lang}}">{{#if (eq lang "es")}}Añadir entrada{{else}}Add Entry{{/if}}</a>
    </nav>

{{else}}
    <h1 class="login-userMsg">
        {{#if (eq lang "es")}}
            Por favor <a href="/login?lang={{lang}}">inicie sesión </a> para ver las categorías
        {{else}}
            Please <a href="/login?lang={{lang}}">login</a> to view categories and save words and phrases.
        {{/if}}
    </h1>
    {{!-- maybe add image here so not so blank --}}
    <img src="/images/logo.png"/>
{{/if}}